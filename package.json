{
  "name": "dsh-voice-personal",
  "version": "0.1.1",
  "type": "module",
  "description": "Local ASR post-processing for DeepSeek Harness: personal glossary, cross-script transliteration, learned style profile. Wraps the built-in SenseVoice provider.",
  "exports": {
    ".": "./index.js",
    "./correct": "./lib/correct/index.js",
    "./voiceprint": "./lib/voiceprint/index.js",
    "./style": "./lib/style/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "meta": {
    "title": "个人语音识别 / Personal Speech",
    "description": "用你自己的词库与表达习惯纠正听写 · Correct dictation with your own glossary, transliteration and style profile"
  },
  "icon": "./icon.svg",
  "scripts": {
    "test": "node test/correct.test.mjs && node --test test/user-terms.test.mjs && node --test test/audit2-regressions.test.mjs && node lib/style/self-test.js && node lib/voiceprint/selftest.mjs",
    "eval": "node test/eval.mjs",
    "audit": "node skills/asr-text-correction-safety/scripts/audit.mjs all lib/correct/index.js"
  },
  "files": [
    "index.js",
    "lib/",
    "scripts/",
    "test/",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "docs/",
    "LICENSE",
    "LICENSE-APACHE-2.0.txt",
    "THIRD-PARTY-NOTICES.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "speech-to-text",
    "asr",
    "voice-input",
    "chinese",
    "dictation",
    "plugin",
    "cordis"
  ],
  "license": "MIT",
  "homepage": "https://github.com/y16689540962-cloud/dsh-voice-personal#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/y16689540962-cloud/dsh-voice-personal.git"
  },
  "bugs": {
    "url": "https://github.com/y16689540962-cloud/dsh-voice-personal/issues"
  },
  "author": {
    "name": "y16689540962-cloud"
  },
  "engines": {
    "node": ">=20"
  }
}
